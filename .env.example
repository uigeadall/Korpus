# Пример за настройките на средата. Копирай го като `.env.local`.
#
# `.env*` е в `.gitignore` — истинските ключове не влизат в git
# (правило 4). Този файл носи само имената им.

# Снимките по проекта: Gemini 2.5 Flash Image, когото наричат
# „nano banana". Ключ се вади от Google AI Studio.
# Без него вратата `/api/skica` отговаря честно, че не е включена.
GEMINI_API_KEY=

# Кой модел рисува. Празно — днешният по подразбиране.
# Имената се менят; достъпните се виждат с:
#   curl https://generativelanguage.googleapis.com/v1beta/models \
#     -H "x-goog-api-key: $GEMINI_API_KEY"
GEMINI_IMAGE_MODEL=

# Пощата, на която идват запитванията. Празно — формата води към
# страницата за контакт.
TEAM_INBOX_EMAIL=

# Снимките по проекта през Cloudflare Workers AI (FLUX.2). Ако са
# попълнени и двете, Cloudflare е пред Gemini. Токенът иска права
# „Workers AI — Read“ и „Workers AI — Edit“. Account ID се вижда в
# dash.cloudflare.com → Workers AI → „Use REST API“.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Празно — @cf/black-forest-labs/flux-2-klein-4b: най-евтиният, ~130 снимки на ден
# безплатно. По-качествен, но ~3 на ден: @cf/black-forest-labs/flux-2-dev.
CLOUDFLARE_IMAGE_MODEL=
# „gemini“ връща Gemini, когато са настроени и двата.
SKICA_PROVIDER=

# Pollinations — публичен и безплатен FLUX.2 klein 4B. Рисува, когато
# дневният лимит на Cloudflare свърши. Секретен ключ (sk_…) от
# https://enter.pollinations.ai/keys
POLLINATIONS_API_KEY=
# Runware — същият модел за ~$0.0019 на снимка, без абонамент. По избор.
RUNWARE_API_KEY=
