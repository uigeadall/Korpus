# Пример за настройките на средата. Копирай го като `.env.local`.
#
# `.env*` е в `.gitignore` — истинските ключове не влизат в git
# (правило 4). Този файл носи само имената им.

# Снимките по проекта: Gemini 2.5 Flash Image, когото наричат
# „nano banana". Ключ се вади от Google AI Studio.
# Без него вратата `/api/skica` отговаря честно, че не е включена.
GEMINI_API_KEY=

# Пощата, на която идват запитванията. Празно — формата води към
# страницата за контакт.
TEAM_INBOX_EMAIL=
